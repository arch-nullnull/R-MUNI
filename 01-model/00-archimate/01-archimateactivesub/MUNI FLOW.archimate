  <folder name="Business" id="id-3bb89a5eecc540769e1de930ca70a574" type="business">
    <element xsi:type="archimate:BusinessProcess" name="BUP00-CSV FLOW" id="id-1393ce3e12f1498eb06cbefe32f0be91">
      <documentation>Ermöglicht es von CSV Archi Exports in CSV Importformat zu transferieren und anzureichern. Eher seltener Usecase aber gut um das FLOW Script zu testen. FLOW in BPMN Camunda 7 modelliert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="BPU01-CSV 2 CSV" id="id-3431625e8daa424b9f089c21d4ea6049">
      <documentation>Archi CSV &lt;-> CSV Import Archi (war mein erster Test nur für übertragungen von Modell zu Modell sinnhaft wenn man editieren möchte geht und das XLXS Plugin nicht hat. </documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="BPU02-XLSX 2 CSV" id="id-8d6586a812d04fa9aa1e0e646e1fd239">
      <documentation>Archi 5.8 - unterstützungspflichtiges Plugin - XLSX - CSV - Archi CSV Import </documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="BUP03-masterxml2CSV" id="id-5e398e49cb0a4fbd889849a7e7c272c6">
      <documentation>Der CORE Teil dieses Flows er überträgt diese aus den unterschiedlichsten Systemen stammenden master.xml Daten in ein CSV von Archi Import lesbares Format.&#xD;
</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="BUP04-ATL FLOW" id="id-8b98e9a157c845acb0fb8f0049826222">
      <documentation>Neuer Sprint für Integration in Atlassian Assets</documentation>
    </element>
