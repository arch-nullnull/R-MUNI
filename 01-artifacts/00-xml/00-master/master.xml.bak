  <ns0:element identifier="id-f0f0f9edab974e42a6a0c2bfdfd0c2e0" xsi:type="Principle" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">PRI02-Freie Software</ns0:name>
    <ns0:documentation xml:lang="de">Es soll nur Software und Komponenten zum Einsatz kommen die wenigstens in der Community Edition dafür freigegeben sind. Noch besser sind überhaupt freie Software Lösungen für jedem zugänglich sind.</ns0:documentation>
