  <ns0:view identifier="id-f64d491b12334aa0b22cdcd121c929d6" xsi:type="Diagram" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">VIE04-Technology View</ns0:name>
