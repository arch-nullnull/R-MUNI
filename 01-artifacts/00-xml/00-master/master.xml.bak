  <ns0:element identifier="id-01ab2c652ce64460b1b4e2932e725a6e" xsi:type="ApplicationFunction" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">APF04-Camunda 8 Modelle</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-01eb201c03bb4d7c9844a47cfef98e15" xsi:type="Product" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">PRO00-R+MUNI</ns0:name>
    <ns0:documentation xml:lang="de">Mein Ziel ein "Produkt" das man ohne schlechtes Gewissen auch früher oder später für den Zielmarkt einsetzbar macht.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-04d63fc625ef46dd99d301c9d647a626" xsi:type="ApplicationFunction" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">APF06-CSV Import</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-07aa42f89e8d404aa027971535a68236" xsi:type="Outcome" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">OUT00-R+MUNI</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-07de8542053d4739b7fa1a98bbe59798" xsi:type="BusinessRole" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUR01-Entwickler</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-081d94ae4980441e9b29dcc553b77aa0" xsi:type="Resource" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">RES00-Eigenmittel</ns0:name>
    <ns0:documentation xml:lang="de">Wir haben keinen Sponsor oder Unterstützer für R+MUNI daher finanzieren wir uns aus Eigenmittel</ns0:documentation>
    <ns0:properties>
      <ns0:property propertyDefinitionRef="propid-1">
        <ns0:value xml:lang="de" />
      </ns0:property>
    </ns0:properties>
  </ns0:element>
  <ns0:element identifier="id-09378af6e4e54c2bb56f37b056b411d0" xsi:type="ApplicationInterface" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">API00-Archi Gui</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-09f50620d3b840568670d86b175bad08" xsi:type="DataObject" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">DAO06-BPMN&lt;Prozessname&gt;.svg</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-0a367492b3df434f9737a64bdae55abd" xsi:type="Requirement" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">REQ00-Kostenfreier Stack</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-0b7a5ed5e5204f918fe105b956a4c660" xsi:type="BusinessService" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUS01-Individual Anpassungen</ns0:name>
    <ns0:documentation xml:lang="de">Da MUNI ein Set aus Scripts und Applikationen ist muss man immer gewisse Anpassungen an den jeweiligen Benutzer durchführen.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-0d2616a6f51b4263867f2d42d6176276" xsi:type="DataObject" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">DAO00-Archi&lt;modellname&gt;.svg</ns0:name>
    <ns0:documentation xml:lang="de">Archi kann in vielen Image Forment exportieren hier ist das .svg Format gewählt da es optimal ist um es auch als rein optisches Fiels weiter in 3ten Applikationen zu zerlegen.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-0f0b8b3ec7104ab9a902e773a818553f" xsi:type="BusinessProcess" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUP00-3rd Party Import</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-12679af793a742f0b3e5a6c196ca207d" xsi:type="Goal" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">GOA00-R+MUNI Release</ns0:name>
    <ns0:documentation xml:lang="de">Ich möchte ein lauffähiges MUNI Projekt haben das es mir ermöglich intern als Prototype zu fungieren damit ich testen kann wo die ecken sind wo ich es schöner machen muss bzw. funktional verbessern sollte.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-16a08948c74f418ea2d1093df569b12c" xsi:type="Requirement" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">REQ03-wartbar</ns0:name>
    <ns0:documentation xml:lang="de">Ich soll nicht auf 3te angewiesen sein in der Realisierung und Umsetzung.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-1728306f843245c28cdf4c03f931735c" xsi:type="BusinessFunction" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUF02-HTML Report erstellen</ns0:name>
    <ns0:documentation xml:lang="de">Archi stellt das EA - Modell auch als HTML Variante zur Verfügung kann lokal oder auf Webserver bereitgstellt werden.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-1b2321b1993f432d867aab233c737a41" xsi:type="ApplicationInterface" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">API01-Camunda Modeler GUI</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-1cbdbc8e6f784df3a399105b7dab5a00" xsi:type="BusinessObject" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUO00-FLOW</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-1e951c3ecb254860b2a829c8ca2895c3" xsi:type="ApplicationComponent" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">APC02-Crome Browser</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-1feb6dd351ce421c8cec6c3fee8c0f45" xsi:type="Meaning" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">MEA00-Free 4 all</ns0:name>
    <ns0:documentation xml:lang="de">Die Lösung soll im Kern ohne Diensteistung kostenfrei sein.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-2409c8327b9048cd800ad824e9b69e74" xsi:type="Capability" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">CAP03-Projektmanagemen</ns0:name>
    <ns0:documentation xml:lang="de">Klassische Projektmanagement Fähigkeiten. Bevorzugt klassisch kann aber auch Agil sein wenn es für den Usecase erwünscht ist.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-254704aef3534da5b3863619168df04b" xsi:type="BusinessFunction" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUF06-Selbsthilfe</ns0:name>
    <ns0:documentation xml:lang="de">MUNI hat Links und How2 inkludiert.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-26ef9465c2b34a1186baeb41ef79f144" xsi:type="SystemSoftware" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">SYS00-Windows 11 Enterprise</ns0:name>
    <ns0:documentation xml:lang="de">Windows 11 Enterprise ist das Entwickler OS für R+MUNI</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-2846035edbac4e1eac7b177be2423e6b" xsi:type="BusinessObject" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">BUO04-Visuelle Darstellung</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-2a1f094032ac44b982bc88b695a59cec" xsi:type="Principle" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">PRI00-Die Prinzipien sind mir wichtig</ns0:name>
