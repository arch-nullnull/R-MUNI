    <ns0:name xml:lang="de">TEF00-Ordnerstruktur und Rechtevergabe</ns0:name>
    <ns0:documentation xml:lang="de">Das ist ein nicht EA konformes mapping der Ordner und Filestruktur und geht viel zu tief ins Detail um als EA Modell gültigkeit zu haben. Es ist ein ersatz um keinen Toolbruch zu generieren ist aber überraschend gut geeignet wenn man simple verbindungen und Attribute verwendet.</ns0:documentation>
    <ns0:properties>
      <ns0:property propertyDefinitionRef="propid-2">
        <ns0:value xml:lang="de">OS Funktion</ns0:value>
      </ns0:property>
    </ns0:properties>
  </ns0:element>
  <ns0:element identifier="id-c30bd7d49b334338b26168831305c559" xsi:type="ApplicationFunction" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">APF10-Selbsthilfeanleitung</ns0:name>
    <ns0:documentation xml:lang="de">Es sind alle Integrierten Funktionen Beschrieben.</ns0:documentation>
  </ns0:element>
  <ns0:element identifier="id-c3eb6d0e5d344ee788f5eb1a41b1a95e" xsi:type="ApplicationFunction" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">APF03-Camunda 7 Modelle</ns0:name>
  </ns0:element>
  <ns0:element identifier="id-c50b64cab06049b9b724ce5d4ae94c89" xsi:type="Requirement" sourceSystem="archi" sourceModel="MUNI EA.xml">
    <ns0:name xml:lang="de">REQ04-Visuell getrieben</ns0:name>
    <ns0:documentation xml:lang="de">Sofern ohne große Umstände möglich soll die Umsetzung immer auch visuell umsetzbar sein.</ns0:documentation>
  </ns0:element>
