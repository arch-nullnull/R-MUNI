<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="MUNI EA" id="id-5579a330bf134248ba775c56a8321aab" version="5.0.0">
  <folder name="Strategy" id="id-e22d76a92689465dafb47f0364e8440d" type="strategy">
    <element xsi:type="archimate:Resource" name="RES00-Eigenmittel" id="id-081d94ae4980441e9b29dcc553b77aa0">
      <documentation>Wir haben keinen Sponsor oder Unterstützer für R+MUNI daher finanzieren wir uns aus Eigenmittel</documentation>
      <property key="ID3Party"/>
    </element>
    <element xsi:type="archimate:Resource" name="RES01-Gaming Hardware" id="id-6a2333e59af14a0fafb3acb889a9cd39">
      <documentation>R+MUNI hat geringe Anforderungen und läuft akuell auf alter Gaminghardware</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP03-Projektmanagemen" id="id-2409c8327b9048cd800ad824e9b69e74">
      <documentation>Klassische Projektmanagement Fähigkeiten. Bevorzugt klassisch kann aber auch Agil sein wenn es für den Usecase erwünscht ist. </documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP02-Modell Know How" id="id-36208904226a410cbfd08f8c171ea497">
      <documentation>Know How zu den dahinterstehenden Modellen auch wenn sie meistens nur reduziert zum Einsatz kommen um auf den Zielmark passend zu &quot;wirken&quot;. </documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP00-IT Infrastruktur Know How" id="id-d2c06c8e7f184d0a87bae234afd35bb8">
      <documentation>25 Jahre + IT Erfahrung</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="CAP01-Modellierungs Know How" id="id-977695ea242249bdb2b04041b936b8fc">
      <documentation>BPMN 2.0 &amp; Archi sowie klassische Visio und Draw i/o Diagramme</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="VAS04-R+MUNI" id="id-6e36fdfb918c4240acbee5fcf51faf94">
      <documentation>Mein realer Value Stream!! Es wird funktionieren die Zeit wird es zeigen. </documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="VAS00-Enabling" id="id-9df74ba77e634bf19e046fbcdedeaf98">
      <documentation>Das eigentliche Ziel hinter R+MUNI. Befähigen!!!! Format Workshop 2 Tage Crash Modellierungskurs. </documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="VAS02-Individualisierungen" id="id-d0481fda2c9347638cd7f163f57ae765">
      <documentation>R+MUNI ist dafür gemacht sich an Anforderungen anzupassen.</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="VAS05-Unterstützungsleistungen" id="id-ee2df5d1790f4035914f33468504ddb6">
      <documentation>Unterstützungsleistungen können auf Basis Kontingent gebucht werden. Minimum 50h </documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="VAS01-Feature Upgrades" id="id-b3b2b665e3dd4de7b72353031c0228be">
      <documentation>Einbau von zusätzlichen Funktionen</documentation>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="COA00-R+MUNI 1.0 Internal Release" id="id-f25940021ed2491e882cbfc90aab9c0f">
      <documentation>Meine großes erstes Vorhaben im EA - Modell Umfang</documentation>
    </element>
    <element xsi:type="archimate:ValueStream" name="VAS03-Klarheit über Fragestellungen" id="id-2ef9b591145c4d6594e322bfd4b4d9c1"/>
  </folder>
