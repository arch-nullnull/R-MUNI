  <folder name="Motivation" id="id-09a01144a93f42deaade68cfd4a6cc82" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="STA00-Me ;)" id="id-35a102086aab4a5098481707177ebaf6">
      <documentation>Coole Haut ohne Freunde der versucht seine Zeit nicht nur mit Apex Legends zu verschwenden. </documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PRI02-Freie Software" id="id-f0f0f9edab974e42a6a0c2bfdfd0c2e0">
      <documentation>Es soll nur Software und Komponenten zum Einsatz kommen die wenigstens in der Community Edition dafür freigegeben sind. Noch besser sind überhaupt freie Software Lösungen für jedem zugänglich sind. </documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ05-Praxis tauglich" id="id-4eda9886e61e43adbe284fbe6679ee1a"/>
    <element xsi:type="archimate:Requirement" name="REQ01-Leicht zu bedienen" id="id-d1d04a2ed3a54f7bb7bf81e7ccae4d75"/>
    <element xsi:type="archimate:Principle" name="PRI04-Offene Normen und Guidelines" id="id-74363f1797494190ac7e9e2900fda900">
      <documentation>Es sollen nur offene Normen und Guidelines zum Einsatz kommen. </documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="MEA00-Free 4 all" id="id-1feb6dd351ce421c8cec6c3fee8c0f45">
      <documentation>Die Lösung soll im Kern ohne Diensteistung kostenfrei sein. </documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PRI01-Freier Zugang zu Unterlagen" id="id-5579e8de5ea74b94b41cd2ff1113d6f8">
      <documentation>Es soll wenigstens online alles kostenfrei zum nachlesen sein. Vorzugsweise Deutsch aber auch Englisch ist okay. </documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ04-Visuell getrieben" id="id-c50b64cab06049b9b724ce5d4ae94c89">
      <documentation>Sofern ohne große Umstände möglich soll die Umsetzung immer auch visuell umsetzbar sein. </documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ03-wartbar" id="id-16a08948c74f418ea2d1093df569b12c">
      <documentation>Ich soll nicht auf 3te angewiesen sein in der Realisierung und Umsetzung.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PRI03-Offen für Erweiterung" id="id-b41a83116fe2490387753d442f5303cf"/>
    <element xsi:type="archimate:Driver" name="DRV00-Geiler Job" id="id-5f48baf405e2434c8562e4be579f0816"/>
    <element xsi:type="archimate:Assessment" name="ASS00-Mögliche Lösungen" id="id-a629cbaa5892420cbf7ee173c114ae5c"/>
    <element xsi:type="archimate:Outcome" name="OUT00-R+MUNI" id="id-07aa42f89e8d404aa027971535a68236"/>
    <element xsi:type="archimate:Value" name="VAL00-Millionen Sachen" id="id-fa09164a4758456895d442486aff62ea">
      <documentation>Die Möglichkeiten sind durch das einfache modulare Grunddesign enorm und es sind kaum Grenzen gesetzt sofern man es irgendwie in einen einlesbaren Code bekommt den ich interpretieren kann ist es integrierbar wenigstens auf einem rudimentären Level der für den Zielmarkt entsprechend dimensioniert ist. </documentation>
    </element>
    <element xsi:type="archimate:Driver" name="DRV01-Wissbegierde" id="id-4efa44dd2e3d44a69f0945d0f16c195a"/>
    <element xsi:type="archimate:Goal" name="GOA00-R+MUNI Release" id="id-12679af793a742f0b3e5a6c196ca207d">
      <documentation>Ich möchte ein lauffähiges MUNI Projekt haben das es mir ermöglich intern als Prototype zu fungieren damit ich testen kann wo die ecken sind wo ich es schöner machen muss bzw. funktional verbessern sollte. </documentation>
    </element>
    <element xsi:type="archimate:Driver" name="DRV02-Was mich motiviert!" id="id-9f87b3f035bc49ef981b4e32b4936ad6"/>
    <element xsi:type="archimate:Requirement" name="REQ02-Wie es sein sollt" id="id-2e8003103e65443fa5bdb50a9142d97a"/>
    <element xsi:type="archimate:Principle" name="PRI00-Die Prinzipien sind mir wichtig" id="id-2a1f094032ac44b982bc88b695a59cec"/>
    <element xsi:type="archimate:Meaning" name="MEA01-Wie ich denke" id="id-a9c6b3622b6d4b55b8fbd0106eb6dfbb"/>
    <element xsi:type="archimate:Meaning" name="MEA02-Offen entwickelbar" id="id-5806af86e54f4bddadc9d002bb6e30f0">
      <documentation>Es soll jeder offen weierentwickeln können solange der Hintergrund der Lösung gewahrt bleibt</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ00-Kostenfreier Stack" id="id-0a367492b3df434f9737a64bdae55abd"/>
