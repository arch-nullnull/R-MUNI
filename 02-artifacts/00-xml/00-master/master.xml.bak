      <ns0:name xml:lang="de">APF04-Camunda 8 Modelle</ns0:name>
    </ns0:element>
    <ns0:element identifier="id-01eb201c03bb4d7c9844a47cfef98e15" xsi:type="Product" sourceSystem="archi" sourceModel="Architecture.xml">
      <ns0:name xml:lang="de">PRO00-R+MUNI</ns0:name>
      <ns0:documentation xml:lang="de">Mein Ziel ein "Produkt" das man ohne schlechtes Gewissen auch früher oder später für den Zielmarkt einsetzbar macht.</ns0:documentation>
    </ns0:element>
    <ns0:element identifier="id-04d63fc625ef46dd99d301c9d647a626" xsi:type="ApplicationFunction" sourceSystem="archi" sourceModel="Architecture.xml">
